{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "musegauge/suite.schema.json",
  "title": "Suite file <suite_id>@<version>.yaml (spec section 7.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "version", "description", "metrics"],
  "properties": {
    "schema": {"const": 1},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "metrics": {"type": "array", "minItems": 1,
                "items": {"type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9-]+@[0-9]+$"}},
    "default_reference": {"type": "string", "minLength": 1}
  }
}
