# Upstream package (spec section 9.4)
laion-clap==1.1.7
# laion-clap does not list huggingface_hub (spec 9.4). Without an upper bound, huggingface_hub
# 2.x made the resolver pick transformers 4.12.2, whose tokenizers 0.10.3 has no wheel for
